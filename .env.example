# Supabase (bu dosyayı asla commit etme -> kopyasını .env olarak al)
DATABASE_URL="postgresql://<user>:<password>@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@db.<project-ref>.supabase.co:5432/postgres"

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon/publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role/secret-key>"
SUPABASE_JWT_SECRET="<jwt-secret>"
# İsteğe bağlı: asimetrik (ES256) doğrulama için JWKS (Security -> JWT Secrets ekranından)
SUPABASE_JWT_JWKS='{"keys":[]}'

# Backend
PORT=3000
JWT_ISSUER="https://<project-ref>.supabase.co/auth/v1"


# Frontend (apps/frontend/.env)
VITE_API_URL="http://localhost:3000"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon/publishable-key>"