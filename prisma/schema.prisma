// Prisma şeması — Personel ve İnsan Kaynakları Modülü
// MVP kapsamı: organizasyon, personel, kullanıcı, rol-yetki + ileride açılacak
// izin / giriş-çıkış / puantaj tablolarının temeli.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Organizasyon
// ---------------------------------------------------------------------------

model Company {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  shortName   String?
  taxNo       String?
  address     String?
  phone       String?
  website     String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments Department[]
}

model Department {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  name        String
  code        String?
  description String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  units   Unit[]
  employees Employee[]

  @@index([companyId])
  @@map("departments")
}

model Unit {
  id           String  @id @default(uuid()) @db.Uuid
  departmentId String  @db.Uuid
  name         String
  code         String?
  description  String?
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@index([departmentId])
  @@map("units")
}

model WorkLocation {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  code      String?
  address   String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employers Employee[]
  qrCodes   QrCode[]
  attendanceRecords AttendanceRecord[]
  shifts   Shift[]

  @@map("work_locations")
}

model Shift {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  code           String?   @unique
  startTime      String
  endTime        String
  breakMinutes   Int       @default(0)
  description    String?
  workLocationId String?   @db.Uuid
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])
  assignments  ShiftAssignment[]

  @@index([workLocationId])
  @@map("shifts")
}

enum ShiftDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model ShiftAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @db.Uuid
  shiftId     String   @db.Uuid
  day         ShiftDay
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, shiftId, day])
  @@index([employeeId])
  @@index([shiftId])
  @@map("shift_assignments")
}

model Title {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  code      String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("titles")
}

model Position {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  code      String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("positions")
}

// ---------------------------------------------------------------------------
// Personel
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  ACTIVE
  PASSIVE
  SUSPENDED
}

model Employee {
  id             String            @id @default(uuid()) @db.Uuid
  employeeNo     String?           @unique
  firstName      String
  lastName       String
  photoUrl       String?
  email          String?           @unique
  phone          String?
  internalPhone  String?
  externalLine   String?
  identityNo     String?
  birthDate      DateTime?
  gender         String?
  maritalStatus  String?
  bloodType      String?
  educationLevel String?
  note           String?

  status        EmploymentStatus @default(ACTIVE)
  workStartDate DateTime?
  workEndDate   DateTime?

  departmentId   String? @db.Uuid
  unitId         String? @db.Uuid
  workLocationId String? @db.Uuid
  titleId        String? @db.Uuid
  positionId     String? @db.Uuid
  managerId      String? @db.Uuid

  department   Department?   @relation(fields: [departmentId], references: [id])
  unit         Unit?         @relation(fields: [unitId], references: [id])
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])
  title        Title?        @relation(fields: [titleId], references: [id])
  position     Position?     @relation(fields: [positionId], references: [id])
  manager      Employee?     @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]    @relation("EmployeeManager")

  user     User?
  history  EmployeeHistory[]
  leaves   LeaveRequest[]
  overtimes Overtime[]
  punches  AttendanceRecord[]
  shiftAssignments ShiftAssignment[]
  payrollItems PayrollItem[]
  advances     Advance[]
  records      EmployeeRecord[]
  assets       Asset[]
  auditLogs AuditLog[]
  tasks        Task[]
  documents    Document[]
  announcementEmployees AnnouncementEmployee[]
  announcementReads     AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([unitId])
  @@index([workLocationId])
  @@map("employees")
}

// Görev / unvan / birim değişiklik geçmişi (kronolojik takip)
model EmployeeHistory {
  id             String  @id @default(uuid()) @db.Uuid
  employeeId     String  @db.Uuid
  departmentId   String? @db.Uuid
  unitId         String? @db.Uuid
  workLocationId String? @db.Uuid
  titleId        String? @db.Uuid
  positionId     String? @db.Uuid
  effectiveDate  DateTime
  endDate        DateTime?
  changeType     String
  note           String?
  createdById    String? @db.Uuid
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("employee_history")
}

// ---------------------------------------------------------------------------
// Kullanıcı, Rol ve Yetki
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  authId     String?    @unique @db.Uuid // Supabase auth.users.id
  username   String     @unique
  email      String?
  employeeId String?    @unique @db.Uuid
  status     UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])
  roles    UserRole[]
  auditLogs AuditLog[]
  approvedAdvances Advance[] @relation("AdvanceApprover")
  issuedRecords EmployeeRecord[] @relation("RecordIssuer")
  notifications Notification[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  code        String  @unique
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // örn: employee:read, leave:approve
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// İleride açılacak modüllerin temel tabloları
// ---------------------------------------------------------------------------

model LeaveType {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  code          String  @unique
  paid          Boolean @default(true)
  color         String?
  defaultDays   Int?
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())

  requests LeaveRequest[]

  @@map("leave_types")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Overtime {
  id             String         @id @default(uuid()) @db.Uuid
  employeeId     String         @db.Uuid
  date           DateTime
  hours          Float
  rate           Float          @default(1)
  description    String?
  status         OvertimeStatus @default(PENDING)
  approvedById   String?        @db.Uuid
  approvedAt     DateTime?
  rejectionReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("overtime_entries")
}

model LeaveRequest {
  id           String     @id @default(uuid()) @db.Uuid
  employeeId   String     @db.Uuid
  leaveTypeId  String     @db.Uuid
  startDate    DateTime
  endDate      DateTime
  days         Float
  description  String?
  documentUrl  String?
  status       LeaveStatus @default(PENDING)
  approvedById String?    @db.Uuid
  approvedAt   DateTime?
  rejectionReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id])
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

enum PunchType {
  IN
  OUT
}

enum PunchSource {
  PDKS
  QR
  MANUAL
}

model AttendanceRecord {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @db.Uuid
  type       PunchType
  source     PunchSource @default(PDKS)
  timestamp  DateTime
  locationId String?   @db.Uuid
  qrCodeId   String?   @db.Uuid
  deviceInfo String?
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  location WorkLocation? @relation(fields: [locationId], references: [id])

  @@index([employeeId, timestamp])
  @@index([timestamp])
  @@map("attendance_records")
}

model QrCode {
  id             String   @id @default(uuid()) @db.Uuid
  token          String   @unique
  locationId     String   @db.Uuid
  entryPointName String?
  isActive       Boolean  @default(true)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  createdById    String?  @db.Uuid
  updatedAt      DateTime @updatedAt

  location WorkLocation @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@map("qr_codes")
}

// ---------------------------------------------------------------------------
// Maaş / bordro
// ---------------------------------------------------------------------------

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model PayrollItem {
  id             String        @id @default(uuid()) @db.Uuid
  employeeId     String        @db.Uuid
  periodYear     Int
  periodMonth    Int
  baseSalary     Decimal       @db.Decimal(12, 2)
  overtimeAmount Decimal       @default(0) @db.Decimal(12, 2)
  leaveDeduction Decimal       @default(0) @db.Decimal(12, 2)
  bonus          Decimal?      @db.Decimal(12, 2)
  deduction      Decimal?      @db.Decimal(12, 2)
  grossAmount    Decimal       @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  status         PayrollStatus @default(DRAFT)
  note           String?       @db.Text
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("payroll_items")
}

// ---------------------------------------------------------------------------
// Avans
// ---------------------------------------------------------------------------

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model Advance {
  id               String        @id @default(uuid()) @db.Uuid
  employeeId       String        @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  installmentCount Int           @default(1)
  periodYear       Int           @default(0)
  periodMonth      Int           @default(0)
  description      String?       @db.Text
  status           AdvanceStatus @default(PENDING)
  approvedById     String?       @db.Uuid
  approvedAt       DateTime?
  paymentDate      DateTime?
  rejectionReason  String?
  note             String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  approvedBy User?   @relation("AdvanceApprover", fields: [approvedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([periodYear, periodMonth])
  @@map("advances")
}

// ---------------------------------------------------------------------------
// Ceza / Ödül
// ---------------------------------------------------------------------------

enum EmployeeRecordCategory {
  DISCIPLINARY
  REWARD
}

enum EmployeeRecordType {
  WARNING
  REPRIMAND
  SUSPENSION
  DEDUCTION
  TERMINATION
  PRAISE
  AWARD
  CERTIFICATE
}

model EmployeeRecord {
  id          String                 @id @default(uuid()) @db.Uuid
  employeeId  String                 @db.Uuid
  category    EmployeeRecordCategory
  type        EmployeeRecordType
  title       String
  description String?                @db.Text
  date        DateTime
  issuedById  String?                @db.Uuid
  createdById String?                @db.Uuid
  note        String?                @db.Text
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  issuedBy User?    @relation("RecordIssuer", fields: [issuedById], references: [id])

  @@index([employeeId])
  @@index([category])
  @@index([date])
  @@map("employee_records")
}

// ---------------------------------------------------------------------------
// Zimmet
// ---------------------------------------------------------------------------

enum AssetStatus {
  ASSIGNED
  RETURNED
  LOST
  DAMAGED
  SERVICING
}

model Asset {
  id           String      @id @default(uuid()) @db.Uuid
  employeeId   String      @db.Uuid
  name         String
  code         String?
  serialNo     String?
  category     String?
  description  String?     @db.Text
  condition    String?
  assignedDate DateTime?
  returnedDate DateTime?
  status       AssetStatus @default(ASSIGNED)
  note         String?     @db.Text
  issuedById   String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// Denetim İzleri
// ---------------------------------------------------------------------------

enum AuditResult {
  SUCCESS
  FAILURE
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorUserId String?    @db.Uuid
  employeeId String?     @db.Uuid
  action     String // örn: employee.update, leave.approve, role.change
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  result     AuditResult @default(SUCCESS)
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor    User?     @relation(fields: [actorUserId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([actorUserId])
  @@index([employeeId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Görev Yönetimi
// ---------------------------------------------------------------------------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?      @db.Text
  employeeId  String       @db.Uuid
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  assignedAt  DateTime     @default(now())
  dueDate     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  note        String?      @db.Text
  createdById String?      @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Evrak Yönetimi
// ---------------------------------------------------------------------------

enum DocumentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model Document {
  id              String           @id @default(uuid()) @db.Uuid
  documentNo      String?
  subject         String
  content         String?          @db.Text
  employeeId      String?          @db.Uuid
  unitId          String?          @db.Uuid
  priority        DocumentPriority @default(NORMAL)
  status          DocumentStatus   @default(PENDING)
  processType     String?
  receivedAt      DateTime?
  lastActionAt    DateTime?
  attachmentUrl   String?
  note            String?          @db.Text
  createdById     String?          @db.Uuid
  updatedById     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([priority])
  @@index([receivedAt])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Duyuru Yönetimi
// ---------------------------------------------------------------------------

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum AnnouncementTargetType {
  ALL
  DEPARTMENT
  UNIT
  SPECIFIC
}

model Announcement {
  id           String                 @id @default(uuid()) @db.Uuid
  title        String
  content      String                 @db.Text
  status       AnnouncementStatus     @default(DRAFT)
  targetType   AnnouncementTargetType @default(ALL)
  targetId     String?                @db.Uuid // departmentId, unitId, or null
  publishAt    DateTime?
  expireAt     DateTime?
  createdById  String?                @db.Uuid
  updatedById  String?                @db.Uuid
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  targetEmployees AnnouncementEmployee[]
  reads           AnnouncementRead[]
  notifications   Notification[]

  @@index([status])
  @@index([targetType])
  @@index([publishAt])
  @@map("announcements")
}

// Belirli personellere gönderilen duyurularda hedef liste
model AnnouncementEmployee {
  announcementId String @db.Uuid
  employeeId     String @db.Uuid

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([announcementId, employeeId])
  @@map("announcement_employees")
}

// Duyuru okundu takibi
model AnnouncementRead {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @db.Uuid
  employeeId     String   @db.Uuid
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@index([employeeId])
  @@map("announcement_reads")
}

// ---------------------------------------------------------------------------
// Bildirim
// ---------------------------------------------------------------------------

enum NotificationType {
  LEAVE_REQUEST
  LEAVE_APPROVED
  LEAVE_REJECTED
  OVERTIME_REQUEST
  OVERTIME_APPROVED
  OVERTIME_REJECTED
  TASK_ASSIGNED
  TASK_DUE_SOON
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  ANNOUNCEMENT
  ASSET_ASSIGNED
  ASSET_RETURNED
  GENERAL
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String?
  entityType     String?          // 'leave', 'overtime', 'task', etc.
  entityId       String?          @db.Uuid
  announcementId String?          @db.Uuid
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}